---
import Base from '../../layouts/Base.astro';
import LessonV2 from '../../features/lesson-v2/LessonV2.astro';
import { lessons, inlineText } from '../../lib/content';
import type { Lesson } from '../../lib/types';

export function getStaticPaths() {
  return lessons.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } }));
}

interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
---

<Base title={`Bài ${lesson.id}. ${lesson.title}`} description={inlineText(lesson.objectives[0] ?? [])} active={String(lesson.grade)} og={lesson.slug}>
  <LessonV2 lesson={lesson} />
</Base>
