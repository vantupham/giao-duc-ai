---
import BaseV2 from '../../layouts/BaseV2.astro';
import LessonV2 from '../../features/lesson-v2/LessonV2.astro';
import { getLesson, inlineText, url } from '../../lib/content';

const lesson = getLesson('bai-11-10');
const hrefOf = (slug: string) => url(slug === 'bai-11-10' ? `ban-mau/${slug}/` : `bai/${slug}`);
---

<BaseV2 title={`Bản mẫu · Bài ${lesson.id}. ${lesson.title}`} description={inlineText(lesson.objectives[0] ?? [])} active="11" proto="lesson">
  <LessonV2 lesson={lesson} hrefOf={hrefOf} />
</BaseV2>
