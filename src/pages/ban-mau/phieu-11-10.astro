---
import BaseV2 from '../../layouts/BaseV2.astro';
import WorksheetStepper from '../../features/worksheet/WorksheetStepper';
import { getWorksheet } from '../../features/worksheet/registry';
import { getLesson, url } from '../../lib/content';

const ws = getWorksheet('bai-11-10')!;
const lesson = getLesson('bai-11-10');
---

<BaseV2 title="Bản mẫu · Phiếu học tập từng bước" active="11" proto="worksheet">
  <div class="v2-wrap" style="max-width:860px;padding-top:40px;--lc:var(--g11)">
    <p class="mono" style="color:var(--accent);margin:0 0 6px">Phiếu cuối bài · bản xem riêng</p>
    <h1 class="display" style="margin:0 0 8px;font-size:clamp(1.8rem,4vw,2.6rem)">Mỗi màn hình một câu</h1>
    <p class="muted" style="margin:0 0 32px;max-width:60ch">
      Trong trang bài, phiếu này nằm ở cuối <a href={url('ban-mau/bai-11-10/#phieu-hoc-tap')}>Bài {lesson.id}</a>. Bài làm dùng chung với phiếu ở đó và ở trang cũ, nộp xong sẽ hiện thẻ thành tích và mã QR.
    </p>
    <WorksheetStepper client:load ws={ws} />
  </div>
</BaseV2>
