---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/v2/PageHead.astro';
import TeacherDashboard from '../../features/teacher/TeacherDashboard';
---

<Base title="Tổng hợp phiếu học tập" active="teacher" description="Quét mã QR phiếu học tập của học sinh và xem mức đạt từng mục tiêu.">
  <div class="v2-wrap">
    <PageHead
      kicker="Dành cho thầy cô · không gửi dữ liệu lên mạng"
      title="Tổng hợp phiếu học tập"
      lead="Học sinh làm phiếu ở cuối bài, rồi đưa mã QR lên trước camera của máy này hoặc gửi link nộp phiếu cho thầy cô. Bấm vào link là phiếu được nhận ngay. Website chấm theo từng mục tiêu, gom lỗi hiểu sai phổ biến và lưu kết quả trong trình duyệt."
    />
    <TeacherDashboard client:load />
  </div>
</Base>
