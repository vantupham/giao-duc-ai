---
import Base from '../layouts/Base.astro';
import { GRADES, getGrade, lessonsOfGrade, lessons, url } from '../lib/content';
import { LAB_PLACEMENTS } from '../features/labs/registry';
import { worksheets } from '../features/worksheet/registry';

const labs = Object.entries(LAB_PLACEMENTS).flatMap(([slug, ls]) => ls.map((l) => ({ ...l, slug, lesson: lessons.find((x) => x.slug === slug)! })));
const GRADE_TAGLINE: Record<number, string> = {
  10: 'Làm chủ AI: con người, pháp luật, câu lệnh, dữ liệu.',
  11: 'Dùng AI an toàn và nhìn vào bên trong hệ thống AI.',
  12: 'Kiểm soát, đánh giá và hợp tác làm ra sản phẩm AI.',
};
---

<Base title="Trang chủ">
  <section class="hero">
    <svg class="hero-net" viewBox="0 0 600 400" aria-hidden="true">
      {
        Array.from({ length: 4 }, (_, l) =>
          Array.from({ length: 5 }, (_, i) => (
            <g>
              {l < 3 &&
                Array.from({ length: 5 }, (_, j) => (
                  <line x1={80 + l * 150} y1={60 + i * 70} x2={230 + l * 150} y2={60 + j * 70} />
                ))}
              <circle cx={80 + l * 150} cy={60 + i * 70} r="9" />
            </g>
          )),
        )
      }
    </svg>
    <div class="wrap hero-inner">
      <p class="hero-kicker">Chuyên đề Giáo dục trí tuệ nhân tạo · THPT</p>
      <h1>Học AI bằng cách <em>chạm vào</em> nó.</h1>
      <p class="hero-lead">
        {lessons.length} bài học từ tài liệu chính thức của Tổ Tin học, kèm mô phỏng 3D, phòng huấn luyện mô hình ngay trên trình duyệt và phiếu học tập nộp bằng mã QR. Không cần tài khoản.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={url('lop-10')}>Bắt đầu từ lớp 10</a>
        <a class="btn" href={url('phong-thi-nghiem')}>Vào phòng thí nghiệm</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="paths" aria-label="Lộ trình theo khối lớp">
      {
        GRADES.map((g) => {
          const data = getGrade(g);
          return (
            <a class="path" href={url(`lop-${g}`)} style={`--gc:var(--g${g})`}>
              <span class="path-grade">Lớp {g}</span>
              <span class="path-tag">{GRADE_TAGLINE[g]}</span>
              <ol>
                {data.topics.map((t) => (
                  <li>{t.title}</li>
                ))}
              </ol>
              <span class="path-meta">
                {data.topics.length} chuyên đề · {lessonsOfGrade(g).length} bài →
              </span>
            </a>
          );
        })
      }
    </section>

    <section class="feature">
      <div>
        <p class="section-kicker">Bản thí điểm</p>
        <h2>Mô phỏng đã có trong bài</h2>
        <p class="muted">Mỗi mô phỏng được chèn đúng chỗ trong bài học, bám theo tình huống của tài liệu: trạm phân loại rác, nơ-ron giấy của Bình, đèn giao thông dùng AI.</p>
      </div>
      <div class="lab-list">
        {
          labs.map((l) => (
            <a class="lab-item" href={url(`bai/${l.slug}#lab-${l.key}`)}>
              <span class="lab-item-lesson">Bài {l.lesson.id}</span>
              <strong>{l.title.replace(/^[^:]+:\s*/, '')}</strong>
              <span class="small muted">{l.description}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="two-ways">
      <div class="card">
        <h3>Em là học sinh</h3>
        <ol>
          <li>Đọc bài trước khi đến lớp, dừng lại ở các hộp <strong>Khái niệm</strong>, <strong>Dễ nhầm</strong>.</li>
          <li>Thử mô phỏng: kéo, bấm, huấn luyện, quan sát.</li>
          <li>Làm <strong>phiếu học tập</strong> cuối bài và đưa mã QR cho thầy cô.</li>
        </ol>
        <p class="small muted">Câu trả lời, ảnh webcam và kết quả chỉ lưu trên máy em.</p>
      </div>
      <div class="card">
        <h3>Thầy cô giáo viên</h3>
        <ol>
          <li>Bấm nút <strong>Giáo viên</strong> trên thanh đầu trang để hiện tiến trình 45 phút, slide và phiếu ra cửa.</li>
          <li>Trình chiếu mô phỏng ở <strong>chế độ trình chiếu</strong> cho cả lớp.</li>
          <li>Mở <a href={url('giao-vien/tong-hop-phieu')}>Tổng hợp phiếu</a>, quét mã QR của học sinh để xem mức đạt từng mục tiêu và lỗi hiểu sai phổ biến.</li>
        </ol>
        <p class="small muted">{worksheets.length} phiếu học tập đã sẵn sàng; các bài khác đang được biên soạn.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 56px;
    background:
      radial-gradient(circle at 85% 20%, color-mix(in srgb, var(--g11) 18%, transparent), transparent 45%),
      radial-gradient(circle at 10% 90%, color-mix(in srgb, var(--g10) 16%, transparent), transparent 40%);
  }

  .hero-net {
    position: absolute;
    right: -60px;
    top: 10px;
    width: min(720px, 90vw);
    opacity: 0.16;
    stroke: var(--text);
    fill: var(--text);
    stroke-width: 1;
  }

  .hero-inner {
    position: relative;
  }

  .hero-kicker {
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin: 0;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 7vw, 4.4rem);
    letter-spacing: -0.02em;
    max-width: 14ch;
    margin: 12px 0 16px;
  }

  .hero h1 em {
    font-style: normal;
    background: linear-gradient(90deg, var(--g10), var(--g11), var(--g12));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 60ch;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .hero-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .paths {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: -12px;
  }

  .path {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 6px solid var(--gc);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.2s;
  }

  .path:hover {
    transform: translateY(-4px);
  }

  .path-grade {
    font-size: 2rem;
    font-weight: 800;
    color: var(--gc);
    line-height: 1;
  }

  .path-tag {
    font-weight: 600;
  }

  .path ol {
    margin: 6px 0;
    padding-left: 1.2em;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .path-meta {
    margin-top: auto;
    font-weight: 700;
    color: var(--gc);
  }

  .feature {
    display: grid;
    gap: 24px;
    margin-top: 56px;
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }

  .lab-list {
    display: grid;
    gap: 10px;
  }

  .lab-item {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    border-left: 4px solid var(--accent);
  }

  .lab-item:hover {
    border-color: var(--accent);
  }

  .lab-item-lesson {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
  }

  .two-ways {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin-top: 48px;
  }

  .two-ways h3 {
    margin-top: 0;
  }
</style>
