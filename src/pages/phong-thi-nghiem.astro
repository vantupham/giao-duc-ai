---
import Base from '../layouts/Base.astro';
import PageHead from '../components/v2/PageHead.astro';
import LabGallery from '../features/labs/LabGallery.astro';
import { LAB_PLACEMENTS } from '../features/labs/registry';

const count = Object.values(LAB_PLACEMENTS).flat().length;
const PLANNED = [
  { lesson: '10.10', title: 'Gây “bệnh” cho dữ liệu', text: 'Thêm nhãn sai, làm lệch nhóm, xem độ chính xác tụt.' },
  { lesson: '10.12', title: 'Trạm rác “ba tháng sau”', text: 'Thanh trượt thời gian: bao bì mới xuất hiện, mô hình xuống phong độ.' },
  { lesson: '11.9', title: 'Chiếc loa biết trả lời', text: 'Nhận dạng giọng nói tiếng Việt chạy trên máy, từng trạm của dây chuyền.' },
  { lesson: '11.11', title: 'Phân cụm 3D', text: 'Kéo tâm cụm, xem k-means từng bước; câu tiếng Việt trong không gian 3D.' },
  { lesson: '12.1', title: 'Vòng đời 8 giai đoạn 3D', text: 'Tìm ba chỗ lỗi được “gieo” trong ứng dụng chấm phát âm.' },
  { lesson: '12.5', title: 'Ma trận rủi ro', text: 'Kéo 12 tình huống vào ô hậu quả × khả năng, đề xuất cách hạ mức.' },
  { lesson: '12.9', title: '“Chính xác 95%” nghĩa là gì?', text: 'Ma trận nhầm lẫn, kéo ngưỡng, tách số liệu theo nhóm.' },
];
const gradeOf = (id: string) => id.split('.')[0];
---

<Base title="Phòng thí nghiệm" active="lab">
  <div class="v2-wrap">
    <PageHead
      kicker={`Phòng thí nghiệm · ${count} mô phỏng`}
      title="Đọc lí thuyết xong, thử ngay"
      lead="Mọi mô phỏng chạy ngay trên trình duyệt, không cần cài đặt, không gửi dữ liệu đi đâu. Mỗi mô phỏng nằm đúng chỗ trong bài học để em đọc rồi thử liền."
    />
    <LabGallery />

    <section class="lab-planned" aria-labelledby="planned-h">
      <p class="mono page-kicker">Bản vẽ · đang xây dựng</p>
      <h2 id="planned-h" class="display">Sắp có</h2>
      <ul>
        {
          PLANNED.map((p) => (
            <li style={`--lc:var(--g${gradeOf(p.lesson)})`}>
              <span class="mono">Bài {p.lesson}</span>
              <strong>{p.title}</strong>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .lab-planned {
    margin-top: var(--s-7);
  }
  .lab-planned h2 {
    margin: 0 0 var(--s-4);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
  }
  .lab-planned ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--s-3);
  }
  .lab-planned li {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border: 1.5px dashed var(--lc);
    border-radius: var(--r-2);
    background:
      linear-gradient(color-mix(in srgb, var(--lc) 10%, transparent) 1px, transparent 1px) 0 0 / 14px 14px,
      linear-gradient(90deg, color-mix(in srgb, var(--lc) 10%, transparent) 1px, transparent 1px) 0 0 / 14px 14px;
  }
  .lab-planned .mono {
    color: var(--lc);
    font-size: 0.68rem;
  }
  .lab-planned strong {
    line-height: 1.35;
  }
  .lab-planned li > span:last-child {
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
