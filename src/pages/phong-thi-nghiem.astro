---
import Base from '../layouts/Base.astro';
import { lessons, url } from '../lib/content';
import { LAB_PLACEMENTS } from '../features/labs/registry';

const items = Object.entries(LAB_PLACEMENTS).flatMap(([slug, ls]) => ls.map((l) => ({ ...l, lesson: lessons.find((x) => x.slug === slug)! })));
const PLANNED = [
  { lesson: '10.10', title: 'Gây “bệnh” cho dữ liệu', text: 'Thêm nhãn sai, làm lệch nhóm, xem độ chính xác tụt.' },
  { lesson: '10.12', title: 'Trạm rác “ba tháng sau”', text: 'Thanh trượt thời gian: bao bì mới xuất hiện, mô hình xuống phong độ.' },
  { lesson: '11.9', title: 'Chiếc loa biết trả lời', text: 'Nhận dạng giọng nói tiếng Việt chạy trên máy, từng trạm của dây chuyền.' },
  { lesson: '11.11', title: 'Phân cụm 3D', text: 'Kéo tâm cụm, xem k-means từng bước; câu tiếng Việt trong không gian 3D.' },
  { lesson: '12.1', title: 'Vòng đời 8 giai đoạn 3D', text: 'Tìm ba chỗ lỗi được “gieo” trong ứng dụng chấm phát âm.' },
  { lesson: '12.5', title: 'Ma trận rủi ro', text: 'Kéo 12 tình huống vào ô hậu quả × khả năng, đề xuất cách hạ mức.' },
  { lesson: '12.9', title: '“Chính xác 95%” nghĩa là gì?', text: 'Ma trận nhầm lẫn, kéo ngưỡng, tách số liệu theo nhóm.' },
];
---

<Base title="Phòng thí nghiệm" active="lab">
  <div class="wrap">
    <h1 style="margin-top:32px">Phòng thí nghiệm AI</h1>
    <p class="muted read">Mọi mô phỏng chạy ngay trên trình duyệt, không cần cài đặt, không gửi dữ liệu đi đâu. Mỗi mô phỏng nằm trong bài học tương ứng để em đọc lí thuyết rồi thử ngay.</p>
    <h2>Đã có</h2>
    <div class="grid grid-2">
      {
        items.map((l) => (
          <a class="card lab-card" href={url(`bai/${l.lesson.slug}#lab-${l.key}`)} style={`--gc:var(--g${l.lesson.grade})`}>
            <span class="lab-card-lesson">
              Bài {l.lesson.id} · {l.lesson.title}
            </span>
            <strong>{l.title}</strong>
            <span class="small muted">{l.description}</span>
          </a>
        ))
      }
    </div>
    <h2>Đang xây dựng</h2>
    <div class="grid grid-3">
      {
        PLANNED.map((p) => (
          <div class="card planned">
            <span class="lab-card-lesson">Bài {p.lesson}</span>
            <strong>{p.title}</strong>
            <span class="small muted">{p.text}</span>
          </div>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .lab-card,
  .planned {
    display: grid;
    gap: 6px;
    color: var(--text);
    text-decoration: none;
    border-top: 5px solid var(--gc, var(--line));
  }

  .lab-card:hover {
    border-color: var(--gc);
  }

  .lab-card-lesson {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--gc, var(--muted));
  }

  .planned {
    box-shadow: none;
    background: transparent;
    border-style: dashed;
  }
</style>
